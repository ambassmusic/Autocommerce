rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Connection Health Check
    match /test/{docId} {
      allow read: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && isOwner(userId) &&
        incoming().uid == request.auth.uid &&
        incoming().keys().hasAll(['uid', 'email', 'name', 'role']) &&
        incoming().role in ['merchant', 'superadmin'];
        
      allow update: if isValidId(userId) && (isOwner(userId) || isAdmin()) &&
        incoming().uid == existing().uid &&
        (isAdmin() || incoming().role == existing().role);
        
      allow delete: if isAdmin();
    }

    // Store Collections
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());

      // Products subcollection
      match /products/{productId} {
        allow read: if isValidId(storeId);
        allow create: if isValidId(storeId) && isValidId(productId) &&
          (isOwner(storeId) || isAdmin()) &&
          incoming().keys().hasAll(['id', 'storeId', 'name', 'price', 'stock']) &&
          incoming().storeId == storeId &&
          incoming().price is number &&
          incoming().stock is number;

        allow update: if isValidId(storeId) && isValidId(productId) &&
          (isOwner(storeId) || isAdmin()) &&
          incoming().storeId == existing().storeId;

        allow delete: if isValidId(storeId) && isValidId(productId) &&
          (isOwner(storeId) || isAdmin());
      }

      // Orders subcollection
      match /orders/{orderId} {
        allow read: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
        
        // Customers can place orders
        allow create: if isValidId(storeId) && isValidId(orderId) &&
          incoming().keys().hasAll(['id', 'storeId', 'customerName', 'total', 'status']) &&
          incoming().storeId == storeId &&
          incoming().total is number;

        allow update: if isValidId(storeId) && isValidId(orderId) &&
          (isOwner(storeId) || isAdmin());

        allow delete: if isValidId(storeId) && isValidId(orderId) &&
          (isOwner(storeId) || isAdmin());
      }

      // Store Settings & WhatsApp Status
      match /settings/{settingId} {
        allow read: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
        allow write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }

      // Customer Leads CRM
      match /leads/{leadId} {
        allow read, write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }

      // Appointments Bookings
      match /appointments/{appointmentId} {
        allow read, write: if isValidId(storeId) && (isOwner(storeId) || isAdmin());
      }
    }
  }
}
